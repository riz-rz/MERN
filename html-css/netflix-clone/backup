.hero{
    height: 100vh;
    background-image: url('bg-image.jpg');
    background-position: top;
    background-size: cover;
    position: relative;
}

/* the black tint */

.hero::before{
    position: absolute;
    height: 100%;
    content: '';
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.452) 0%,rgba(0, 0, 0, 0.274) 50%, rgba(0, 0, 0, 0.267) 100%);
    inset: 0;
}   

